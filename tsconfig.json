{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "resolveJsonModule": true,
    "esModuleInterop": true, "declaration": true, "outDir": "dist", "noEmit": true
  },
  "include": ["src", "demo/*.tsx", "vite.config.ts"]
}
